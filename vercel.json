{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/assets/:path*", "destination": "/JS%2010/assets/:path*" },
    { "source": "/index.php", "destination": "/api/index.php?route=index.php" },
    {
      "source": "/:section(auth|anggota|buku|penyewaan)/:file*",
      "destination": "/api/index.php?route=:section/:file"
    }
  ],
  "redirects": [
    { "source": "/", "destination": "/index.php", "permanent": false }
  ]
}
